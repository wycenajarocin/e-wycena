# ============================================================================
#  SZABLON SEKRETÓW dla Edge Functions
#
#  JAK UŻYĆ:
#    1. Skopiuj ten plik jako  supabase\.env.secrets
#    2. Uzupełnij wartości
#    3. Wyślij do Supabase:
#         & $sb secrets set --project-ref TWOJ_REF --env-file supabase\.env.secrets
#
#  UWAGA: plik .env.secrets NIGDY nie może trafić do repozytorium ani na
#  serwer strony. Jest już wpisany do .gitignore. Po wysłaniu sekretów
#  możesz go spokojnie usunąć — wartości są zapisane po stronie Supabase.
#
#  Nie dodawaj tutaj SUPABASE_URL, SUPABASE_ANON_KEY ani
#  SUPABASE_SERVICE_ROLE_KEY — Supabase ustawia je funkcjom automatycznie.
# ============================================================================

# Adresy stron, z których wolno wywoływać funkcje (bez ukośnika na końcu).
# Rozdzielone przecinkami, bez spacji.
ALLOWED_ORIGINS=https://TWOJADOMENA.pl,http://localhost:5500

# --- Poniższe dwie linie są OPCJONALNE ---
# Bez nich import z Otodom i dodawanie ręczne działają normalnie,
# tylko bez automatycznego porządkowania tekstu przez AI.

OPENAI_API_KEY=sk-wklej-tutaj-swoj-klucz
OPENAI_MODEL=gpt-5.5-mini
